# =============================================================================
# JobFarm Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your configuration:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Job Profile & Geographic Targeting
# -----------------------------------------------------------------------------
# Active profile: 'it' or 'general' (maps to profiles/ and config/<profile>/)
JOB_PROFILE=it
PROFILES_ROOT=./profiles

# Primary geographic targeting (defaults to Metro Vancouver)
TARGET_LOCATION="Vancouver, BC"
TARGET_REGION=METRO_VAN
METRO_VANCOUVER_ONLY=1

# -----------------------------------------------------------------------------
# 2. Autonomous Multi-Model AI / LLM Gateway
# -----------------------------------------------------------------------------
# Provider options: 'ollama' (free offline local), 'deepseek', 'openai', 'groq', 'gemini', 'openrouter'
LLM_PROVIDER=ollama

# Local Ollama Settings (100% free offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud AI API Keys (Optional if using Ollama)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# 3. Anti-Detection & CAPTCHA Solver Settings
# -----------------------------------------------------------------------------
# Primary solver: 'capsolver' (supports AntiCloudflare cf_clearance, Turnstile, reCAPTCHA)
CAPTCHA_CLOUDFLARE_SOLVER=capsolver
USE_CAPSOLVER=1
CAPSOLVER_API_KEY=

# Secondary solver (CapMonster fallback)
USE_CAPMONSTER=0
CAPMONSTER_CLIENT_KEY=

# Local GUI / mouse-humanizer fallback
CAPTCHA_ALLOW_GUI_FALLBACK=0
CAPTCHA_ALLOW_MANUAL_FALLBACK=0

# -----------------------------------------------------------------------------
# 4. Proxy Configuration (Datacenter & Residential)
# -----------------------------------------------------------------------------
# Set to '1' to disable proxies and run via direct workstation connection
BYPASS_PROXY=1

# Webshare Residential Sticky Proxy (recommended for Cloudflare-heavy portals)
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
WEBSHARE_PROXY_HOST=p.webshare.io
WEBSHARE_PROXY_PORT=80
WEBSHARE_PROXY_URL=

# Proxy bound to CapSolver tasks (must match browser egress for cf_clearance)
CAPSOLVER_PROXY_URL=

# -----------------------------------------------------------------------------
# 5. Database & Queue Configuration
# -----------------------------------------------------------------------------
# MongoDB connection URI and database name
MONGODB_URI=mongodb://localhost:27017
JOBBOTS_MONGO_DATABASE=jobbots

# -----------------------------------------------------------------------------
# 6. Farm Supervisor & Application Safeguards
# -----------------------------------------------------------------------------
# Run unattended without waiting for interactive start confirmation
AUTONOMOUS_SUPERVISOR=1
SKIP_USER_START=1

# Rate limiting and company cooldown
MAX_APPLICATIONS_PER_COMPANY=1
COMPANY_COOLDOWN_DAYS=14
LINKEDIN_COMPANY_THROTTLE=0

# Job Bank keyword discovery mode ('core' or 'hero')
JOBBOTS_JOBBANK_TERM_SET=core
JOBBOTS_JOBBANK_KEYWORDS=

# -----------------------------------------------------------------------------
# 7. Candidate Profile & PII (Optional overrides for form autofill)
# -----------------------------------------------------------------------------
CANDIDATE_FIRST_NAME=Jane
CANDIDATE_LAST_NAME=Doe
CANDIDATE_EMAIL=user@example.com
CANDIDATE_PHONE=+1-555-0199
CANDIDATE_CITY=Vancouver
CANDIDATE_STREET="100 Main Street"
CANDIDATE_STATE=BC
CANDIDATE_ZIPCODE="V6B 1A1"
CANDIDATE_COUNTRY=Canada
# Equal Opportunity Self-ID ("Decline", "Yes", "No", "Male", "Female", etc.)
CANDIDATE_ETHNICITY=Decline
CANDIDATE_GENDER=Decline
CANDIDATE_PRONOUNS="They/Them"
CANDIDATE_DISABILITY=Decline
CANDIDATE_VETERAN=Decline
# Path to custom PDF resume (optional: defaults to profiles/resumes/sample_resume_<profile>.pdf)
# RESUME_PATH=./profiles/resumes/my_resume.pdf

# -----------------------------------------------------------------------------
# 8. Notifications & Alerts (Optional)
# -----------------------------------------------------------------------------
# Telegram bot alerts (leave blank if not using Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

