gcp_project_id        = "your-gcp-project-id"
gcp_region            = "us-west1"
gcp_zone              = "us-west1-a"
vm_name               = "jobbots-dev-vm"
machine_type          = "e2-standard-4"
boot_disk_size_gb     = 64
golden_image_family   = "ubuntu-2404-lts-amd64"
