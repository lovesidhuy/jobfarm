aws_region               = "us-west-2"
availability_zone        = "us-west-2a"
environment              = "canary"
deployment_tier          = "canary"
resource_prefix          = "jobbots-canary-CHANGE_ME"
vm_name                  = "jobbots-canary-CHANGE_ME-worker"
instance_type            = "m6i.large"
root_volume_size_gb      = 32
golden_image_id          = "ami-REPLACE_ME"
persistent_volume_id     = "vol-REPLACE_ME"
profile_lease_table_name = "jobbots-canary-CHANGE_ME-profile-leases"
profile_lease_table_arn  = "arn:aws:dynamodb:us-west-2:ACCOUNT_ID:table/jobbots-canary-CHANGE_ME-profile-leases"
artifact_bucket_name     = "jobbots-canary-CHANGE_ME-artifacts-REPLACE"
artifact_bucket_arn      = "arn:aws:s3:::jobbots-canary-CHANGE_ME-artifacts-REPLACE"
runtime_secret_name      = "jobbots-canary-CHANGE_ME/runtime"
runtime_secret_arn       = "arn:aws:secretsmanager:us-west-2:ACCOUNT_ID:secret:jobbots-canary-CHANGE_ME/runtime-REPLACE"
artifact_prefix          = "canary/CHANGE_ME"
