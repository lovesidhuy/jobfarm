aws_region               = "us-west-2"
availability_zone        = "us-west-2a"
environment              = "canary"
deployment_tier          = "canary"
resource_prefix          = "jobbots-canary-CHANGE_ME"
vm_name                  = "jobbots-canary-CHANGE_ME-worker"
instance_type            = "m6i.large"
root_volume_size_gb      = 64
golden_image_id          = ""
persistent_volume_id     = "vol-REPLACE_ME"
profile_lease_table_name = "dev-jobbots-profile-leases"
profile_lease_table_arn  = "arn:aws:dynamodb:us-west-2:ACCOUNT_ID:table/dev-jobbots-profile-leases"
artifact_bucket_name     = "REPLACE_ME-jobbots-artifacts"
artifact_bucket_arn      = "arn:aws:s3:::REPLACE_ME-jobbots-artifacts"
runtime_secret_name      = "dev/jobbots/runtime"
runtime_secret_arn       = "arn:aws:secretsmanager:us-west-2:ACCOUNT_ID:secret:dev/jobbots/runtime-REPLACE"
artifact_prefix          = "canary/CHANGE_ME"
allowed_rdp_ip_v4        = "YOUR.PUBLIC.IP/32"
allowed_rdp_ip_v6        = ""
# vm_admin_password      = "set-via-TF_VAR_vm_admin_password-or-CI-secret"
