# ──────────────────────────────────────────────────────────────────────────────
# Infisical Bootstrap (required to connect to Infisical)
# Copy this file to .env and fill in your actual values.
# ──────────────────────────────────────────────────────────────────────────────

INFISICAL_CLIENT_ID=<your-infisical-machine-identity-client-id>
INFISICAL_CLIENT_SECRET=<your-infisical-machine-identity-client-secret>
INFISICAL_PROJECT_SLUG=<your-infisical-project-slug>
INFISICAL_ENV=dev

# ──────────────────────────────────────────────────────────────────────────────
# All secrets below MUST be stored in Infisical, NOT in this file.
# Add them via the Infisical dashboard or CLI: `infisical secrets set KEY VALUE`
# ──────────────────────────────────────────────────────────────────────────────
#
# IMAP_EMAIL_IT
# IMAP_APP_PASSWORD_IT
# IMAP_EMAIL_GENERAL
# IMAP_APP_PASSWORD_GENERAL
# Greenhouse and Lever applications always use this separate mailbox.
# ATS_GREENHOUSE_LEVER_EMAIL=user@example.com
# ATS_GREENHOUSE_LEVER_IMAP_APP_PASSWORD=<Gmail app password for that mailbox>
# CAPMONSTER_CLIENT_KEY
# CAPMONSTER_API_KEY
# CAPMONSTER_PROXY_URL
# PROXY_URL
#
# JobSpy scrape proxy ladder (smart fallbacks; absent keys are skipped):
#   Production (AWS): Webshare static + Proxy-Cheap rotating. No DataImpulse.
#   1) local IP (skipped on cloud when JOBSPY_SKIP_LOCAL=1)
#   2) Webshare static — JOBSPY_PROXY_WEBSHARE / WEBSHARE_PROXY_URL
#   3) Proxy-Cheap rotating — PROXY_URL / CAPMONSTER_PROXY_URL
#      (legacy aliases JOBSPY_PROXY_DATAIMPULSE / DATAIMPULSE_PROXY_URL still accepted)
# HTTP 407 permanently disables that tier for the process (no thrash).
# JOBSPY_PROXY_MODE=smart
# JOBSPY_SKIP_LOCAL=1
# JOBSPY_PROXY_WEBSHARE=http://user:pass@host:port
# WEBSHARE_PROXY_URL=http://user:pass@host:port
# PROXY_URL=http://user:pass@thehub.proxy-cheap.com:8080
# CAPMONSTER_PROXY_URL=...   # should match browser residential proxy for captcha
# JOBSPY_PROXY_ALTERNATE_EVERY=3
# JOBSPY_PROXY_STEP_DOWN_AFTER=8
# Legacy fixed list (disables smart ladder): JOBSPY_PROXY_URLS=url1,url2
# MONGODB_URI
# JOBBOTS_MONGO_DATABASE=jobbots
# GROQ_API_KEY
# LLM_API_KEY
#
# LLM gateway (prefer Akash ML DeepSeek V4 Flash):
# LLM_PROVIDER=akashml
# AKASHML_API_KEY=akml-...
# AKASHML_BASE_URL=https://api.akashml.com/v1
# AKASHML_MODEL=deepseek-ai/DeepSeek-V4-Flash
# BLUESMINDS_API_KEY=akml-...          # alias of AKASHML_API_KEY (same key works)
# BLUESMINDS_BASE_URL=https://api.akashml.com/v1
# BLUESMINDS_MODEL=deepseek-ai/DeepSeek-V4-Flash
# OPENROUTER_API_KEY=...               # fallback only
#
# Web discovery / scrape — self-hosted Firecrawl (preferred):
#   scripts/start_firecrawl.sh   → http://127.0.0.1:3002
# --- Firecrawl cloud (student credits) — ATS search fail-safe ONLY ---
# Do NOT enable scrape for all modules; search is used by firecrawl_ats only.
# FIRECRAWL_SELF_HOST=0
# FIRECRAWL_API_BASE=https://api.firecrawl.dev
# FIRECRAWL_API_KEY=fc-...             # Infisical + local .env (never commit real key)
# FIRECRAWL_ATS_ENABLED=0              # optional fail-safe only; factory works at 0
# FIRECRAWL_ATS_MAX_RESULTS=8          # keep low on student plan
# FIRECRAWL_ATS_VARIANTS=1             # 1 saves credits; 2–3 for more coverage
# FIRECRAWL_SCRAPE_ENABLED=0           # page scrape off by default (costs more)
# GOOGLE_CDP_FIRECRAWL_FALLBACK=0      # only when Google CDP empty AND credits available
# GOOGLE_CDP_TAVILY_FALLBACK=1
# GOOGLE_CDP_TAVILY_ALWAYS=0
# Optional self-host (RAM-heavy Docker): FIRECRAWL_SELF_HOST=1 FIRECRAWL_API_BASE=http://127.0.0.1:3002 FIRECRAWL_API_KEY=local
# TAVILY_API_KEY=...                   # Premium: primary CAPTCHA-free ATS lead finder
# TAVILY_ATS_ENABLED=1
# TAVILY_ATS_SEARCH_DEPTH=advanced     # basic|advanced (default advanced)
# TAVILY_ATS_MAX_RESULTS=15            # per query, max 20
# TAVILY_ATS_TIME_RANGE=none           # day|week|month|year|none (default none = max recall)
# TAVILY_ATS_PARALLEL=4                # concurrent term searches
# TAVILY_ATS_VARIANTS=2                # metro dork + Canada remote (+ job-boards if 3)
# TAVILY_ATS_ENRICH_TITLES=1           # fetch <title> for board-noise SERP rows
# TAVILY_ATS_ENRICH_MAX=12             # max title fetches per term
#
# BOT_LOGIN_USERNAME
# BOT_LOGIN_PASSWORD
# BOT_NAME
# JOB_PROFILE
# CDP_PORT
# BOT_INSTANCE_ID
# CAPTCHA_CLOUDFLARE_SOLVER
# OLLAMA_BASE_URL
# CHROME_PROFILE_DIR
# Production Linux/NSTbrowser runtime
# BROWSER_VENDOR=nstbrowser
# Dual subscription support (slot 1 = tested logins, slot 2 = spare daily opens):
# NSTBROWSER_API_KEY              # slot 1
# NSTBROWSER_API_KEY_2            # slot 2
# NSTBROWSER_ACTIVE_SLOT=auto     # auto | 1 | 2
# NSTBROWSER_QUOTA_SOFT_LIMIT=28  # auto → slot 2 when DAILY_OPENS_1 >= limit
# NSTBROWSER_DAILY_OPENS_1=0      # update from NST dashboard
# NSTBROWSER_DAILY_OPENS_2=0
# NSTBROWSER_API_HOST=127.0.0.1
# NSTBROWSER_API_PORT=8848
#
# --- Local Mac apply farm (same queue workers as VM) ---
# Setup:  bash automation_monorepo/scripts/setup_local_env.sh
# Run:    bash automation_monorepo/scripts/run_local_apply_farm.sh start
# Status: bash automation_monorepo/scripts/run_local_apply_farm.sh status
# Tests:  bash automation_monorepo/scripts/run_local_apply_farm.sh test
#
# NST_MODE=local-agent   # default: Nstbrowser.app on :8848 (best for logins)
# NST_MODE=docker        # nstbrowser/browserless (VM-like; needs cloud userdata)
# Never run local-agent + docker on :8848 at the same time.
# CDP on Docker Desktop is auto-proxied via _ensure_nst_cdp_port_proxy in open_chrome.py.
#
# Form fill AI (LinkedIn hybrid_runner + form_answers):
# LLM_PROVIDER=akashml
# AKASHML_API_KEY=…  AKASHML_MODEL=…  AKASHML_BASE_URL=…
# OPENROUTER_API_KEY=…   # optional fallback
# FORM_ANSWERS_DISABLE_AI=1  # CI unit tests only
# Optional Langfuse observability (credentials belong in Infisical, never here).
# LANGFUSE_TRACING_ENABLED=1
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=production
# JOBBOTS_PROFILE_LEASE_TABLE
# Slot 1 profile UUIDs (do not create near quota):
# NSTBROWSER_PROFILE_ID_INDEED_IT
# NSTBROWSER_PROFILE_ID_INDEED_GENERAL
# NSTBROWSER_PROFILE_ID_GLASSDOOR_IT
# NSTBROWSER_PROFILE_ID_GLASSDOOR_GENERAL
# NSTBROWSER_PROFILE_ID_LINKEDIN_IT
# NSTBROWSER_PROFILE_ID_LINKEDIN_GENERAL
# NSTBROWSER_PROFILE_ID_LINKEDIN_DISCOVERY_IT
# NSTBROWSER_PROFILE_ID_LINKEDIN_DISCOVERY_GENERAL
# NSTBROWSER_PROFILE_ID_WORKOPOLIS_IT
# NSTBROWSER_PROFILE_ID_WORKOPOLIS_GENERAL
# Slot 2 parallel set:
# NSTBROWSER_PROFILE_ID_2_INDEED_IT
# NSTBROWSER_PROFILE_ID_2_* …
# Sync: python scripts/sync_nst_dual_accounts.py --sync --write-env --write-infisical

# Keep Nstbrowser open across bot process exits (multi-job / canary same window).
# application_worker --job-ids sets this automatically between jobs.
# KEEP_BROWSER=1
# NSTBROWSER_KEEP_ALIVE=1
#
# PROFILE QUOTA SAFETY (critical when few slots remain, e.g. 3 until cap 30):
# Default ON — refuse POST /api/v2/profiles (auto_nstbrowser_setup, etc.).
# Canary + application_worker force this and require an existing profile UUID.
# For indeed_it Phase II / canary: set NSTBROWSER_PROFILE_ID_INDEED_IT only —
# do NOT create a new profile, do NOT enable NSTBROWSER_ROTATE_PROFILE.
# NSTBROWSER_FORBID_CREATE=1
# To intentionally create profiles (burns quota): NSTBROWSER_FORBID_CREATE=0
# Legacy Windows browser vendors
# IXBROWSER_PROFILE_ID_INDEED_IT
# IXBROWSER_PROFILE_ID_INDEED_GENERAL
# IXBROWSER_PROFILE_ID_GLASSDOOR_IT
# IXBROWSER_PROFILE_ID_LINKEDIN_IT
# IXBROWSER_PROFILE_ID_LINKEDIN_GENERAL

# Google Sheets daily reporter (service account)
# GOOGLE_SPREADSHEET_ID=
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=   # full JSON string (Infisical)
# GOOGLE_SERVICE_ACCOUNT_FILE=   # or path to google_service_account.json
# GOOGLE_SHEET_TAB=Daily Report
# GOOGLE_DRIVE_UPLOAD=0          # 1 only if folder is a Shared Drive the SA can write
