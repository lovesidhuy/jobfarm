#!/usr/bin/env bash
# Load runtime secret JSON from AWS Secrets Manager into /etc/jobbots/secrets.env
# Shell-safe for `source` (NST unit) and systemd EnvironmentFile.
set -euo pipefail
source /etc/jobbots/runtime.conf
: "${JOBBOTS_RUNTIME_SECRET:?JOBBOTS_RUNTIME_SECRET is required}"
# Variables loaded with `source` are shell-local unless exported. AWS CLI uses
# the exported region variables, so make the GCP/AWS hybrid runtime explicit.
export AWS_REGION="${AWS_REGION:-${AWS_DEFAULT_REGION:-}}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-${AWS_REGION:-}}"
export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-}"
export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-}"
: "${AWS_DEFAULT_REGION:?AWS_DEFAULT_REGION is required}"
tmp="$(mktemp)"
out="$(mktemp)"
trap 'rm -f "$tmp" "$out"' EXIT

if [ -s /etc/jobbots/runtime-secret.json ]; then
  install -m 0600 /etc/jobbots/runtime-secret.json "$tmp"
else
  aws secretsmanager get-secret-value \
    --secret-id "$JOBBOTS_RUNTIME_SECRET" \
    --query SecretString \
    --output text >"$tmp"
fi

python3 - "$tmp" "$out" <<'PY'
import json, shlex, sys
from pathlib import Path

src, dst = Path(sys.argv[1]), Path(sys.argv[2])
data = json.loads(src.read_text(encoding="utf-8"))

# Worker always uses local docker Mongo (Infisical may hold Atlas placeholders)
data["MONGODB_URI"] = "mongodb://127.0.0.1:27017"
data["BROWSER_VENDOR"] = data.get("BROWSER_VENDOR") or "nstbrowser"
data["INFISICAL_PROJECT_SLUG"] = data.get("INFISICAL_PROJECT_SLUG") or "mybots-r46g"
data["INFISICAL_ENV"] = data.get("INFISICAL_ENV") or "dev"
if not data.get("INFISICAL_PROJECT_ID"):
    data["INFISICAL_PROJECT_ID"] = "a2aaccb9-2d1a-4338-b8f5-bae3f42d7dbe"

# JSON blobs / multiline break bash `source` and systemd EnvironmentFile
SKIP_KEYS = {
    "GOOGLE_OAUTH_CLIENT_JSON",
    "GOOGLE_SERVICE_ACCOUNT_JSON",
    "GOOGLE_OAUTH_TOKEN_JSON",
}
lines = []
for key in sorted(data.keys()):
    if key in SKIP_KEYS:
        continue
    val = data[key]
    if val is None:
        continue
    s = str(val)
    if "\n" in s or len(s) > 4000:
        continue
    lines.append(f"{key}={shlex.quote(s)}")

dst.write_text("\n".join(lines) + "\n", encoding="utf-8")
print(f"jobbots-load-secrets: wrote {len(lines)} keys")

# Keep Google JSON credentials out of EnvironmentFile, but make them available
# to the reporter as root-owned files on every boot. This also refreshes OAuth
# tokens safely when the backend secret is updated.
credential_files = {
    "GOOGLE_OAUTH_CLIENT_JSON": Path("/etc/jobbots/client_secret.json"),
    "GOOGLE_SERVICE_ACCOUNT_JSON": Path("/etc/jobbots/google_service_account.json"),
    "GOOGLE_OAUTH_TOKEN_JSON": Path("/etc/jobbots/google_oauth_token.json"),
}
for key, path in credential_files.items():
    value = data.get(key)
    if value:
        path.write_text(str(value), encoding="utf-8")
        path.chmod(0o600)
        print(f"jobbots-load-secrets: materialized {key} -> {path}")
PY

# root:ubuntu 640 so service user can source if needed; systemd still reads as root
install -m 0640 -o root -g ubuntu "$out" /etc/jobbots/secrets.env

# Paths are ordinary single-line variables and are safe for systemd.
cat >> /etc/jobbots/secrets.env <<'EOF'
GOOGLE_OAUTH_CLIENT_FILE=/etc/jobbots/client_secret.json
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/jobbots/google_service_account.json
GOOGLE_OAUTH_TOKEN_FILE=/etc/jobbots/google_oauth_token.json
EOF
